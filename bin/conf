#!/usr/bin/env bash
# The `conf` command. A wrapper rather than a shebang on the JS, because the
# flag that silences node's experimental-SQLite warning cannot go in a shebang
# portably.
exec node --no-warnings=ExperimentalWarning \
  "$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/src/cli.js" "$@"
